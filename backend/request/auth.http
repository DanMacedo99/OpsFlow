### Try supplier from another organization
GET http://localhost:3000/suppliers/SUP-001


### Try updating supplier from another organization
PUT  http://localhost:3000/suppliers/SUP-001
Content-Type: application/json

{
    "name": "Unauthorized Update",
    "category": "Logistics",
    "country": "Ireland",
    "riskLevel": "high",
    "assessmentStatus": "review-required",
    "complianceScore": 50,
    "lastAssessmentDate": null
}

### Try deleting supplier from another organization
DELETE http://localhost:3000/suppliers/SUP-001


### Try creating assessment for supplier from another organization
POST http://localhost:3000/suppliers/SUP-001/assessments
Content-Type: application/json

{
    "documentStatus": "verified",
    "notes": "Assessment created for tenant isolation test.",
    "responses": [
        {
            "criterionKey": "information-security",
            "score": 4,
            "notes": "Security controls are documented."
        },
        {
            "criterionKey": "data-protection",
            "score": 4,
            "notes": "Data protection practices are adequate."
        },
        {
            "criterionKey": "regulatory-compliance",
            "score": 3,
            "notes": "Some compliance improvements are required."
        },
        {
            "criterionKey": "operational-resilience",
            "score": 4,
            "notes": "Continuity procedures are available."
        },
        {
            "criterionKey": "financial-stability",
            "score": 3,
            "notes": "Financial position appears acceptable."
        }
    ]
}

### List assessments from another organization
GET http://localhost:3000/suppliers/SUP-001/assessments



### Try finalizing assessment from another organization
PATCH http://localhost:3000/suppliers/SUP-001/assessments/7bff8fa4-5cac-4a10-90bb-3440b704bfc3/decision
Content-Type: application/json

{
    "decision": "approved"
}

### Try changing document status from another organization
PATCH http://localhost:3000/suppliers/SUP-001/assessments/7bff8fa4-5cac-4a10-90bb-3440b704bfc3/document-status
Content-Type: application/json

{
    "documentStatus": "verified"
}